{
  "name": "vortex-imager",
  "version": "0.1.0",
  "type": "module",
  "description": "External avatar, badge, furniture and room imager for Vortex — renders with the client's own ported pipeline",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "start": "node dist/index.js",
    "smoke": "node tools/smoke.mjs",
    "pregenerate": "node tools/pregenerate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ambreia/avatar": "workspace:*",
    "@ambreia/common": "workspace:*",
    "@ambreia/game": "workspace:*",
    "@ambreia/iso": "workspace:*",
    "@ambreia/kernel": "workspace:*",
    "@ambreia/net": "workspace:*",
    "@ambreia/protocol": "workspace:*",
    "@ambreia/ui": "workspace:*",
    "@napi-rs/canvas": "^0.1.71",
    "eventemitter3": "^5.0.1",
    "fastify": "^5.2.0",
    "linkedom": "^0.18.9",
    "lru-cache": "^11.0.2",
    "mysql2": "^3.12.0",
    "pako": "^2.1.0",
    "vortex-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pako": "^2.0.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
