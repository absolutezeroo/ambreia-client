<?xml version="1.0" encoding="UTF-8"?>
<!-- The editor's own: a section title inside a form, like the owner's "Position" / "Propriétés". -->
<layout name="vortex_map_editor_section_xml" width="316" height="22" version="0.1">
  <window>
    <container x="0" y="0" width="316" height="22" params="16" style="3" name="section_row">
      <children>
        <text x="0" y="4" width="316" height="16" params="16" style="3" name="section_label" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="text_color" value="0x1f5f9a" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
      </children>
    </container>
  </window>
</layout>
