{
  "name": "vortex-web",
  "private": true,
  "type": "module",
  "description": "Vortex CMS — a faithful port of habbo.com's website (habbo-web), on the Vortex emulator's own web API",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "api:types": "openapi-typescript ../../../vortex-emulator/Vortex.WebApi/openapi.json -o src/lib/api.generated.ts"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-condensed": "^5.3.0",
    "qrcode": "^1.5.4",
    "svelte-spa-router": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
