# vortex-web — copy to .env and adjust. `.env` and `.env.local` are gitignored, this file is not.

# ── Language ─────────────────────────────────────────────────────────────────
# What the site falls back to: the language a visitor gets when their browser asks for one this
# build does not ship, and the one that fills a key the active language happens not to carry
# (habbo.com's own files do not all carry the same keys — its en.json has 1,317 where fr.json has
# 1,692).
#
# It is a DEPLOYMENT value, and it is the ONLY place a language is named: src/lib/i18n.ts names
# none, and the set of languages is whatever src/locales/ holds. Leave this unset and the fallback
# becomes the first file in that directory alphabetically — `br`, which is nobody's decision.
#
# The visitor's own language still wins over it: ?lang=, then what they chose before, then
# navigator.languages, then this.
VITE_SITE_LOCALE=fr

# ── Hotel ────────────────────────────────────────────────────────────────────
# The hotel's name. NOT a translation — the same word in all nine languages, which is why it is not
# in a locale file. `tools/fetch-l10n.mjs` substitutes it into habbo.com's own strings on the way in
# (283 of French's 1,692 say "Habbo"), and `tools/fetch-web-pages.mjs` does the same to the mirrored
# editorial pages, so BOTH tools must see the same value as the site does.
VITE_HOTEL_NAME=Vortex

# ── Asset host ───────────────────────────────────────────────────────────────
# Empty on purpose, and NOT unset: lib/config.ts falls back to http://vortex-assets.local when this
# is absent, which is an absolute URL only the dev machine can resolve — every picture on the site
# is then broken from a phone, another laptop, or a Cloudflare tunnel.
#
# Empty makes IMAGES a relative `/c_images`, which vite.config.js already proxies to the asset host.
# One origin, so whatever reaches the site reaches its images too.
VITE_ASSET_BASE=

# ── The client ───────────────────────────────────────────────────────────────
# Where /hotel's iframe points. Same origin under /client by default, proxied by the dev server.
# VITE_CLIENT_URL=/client
