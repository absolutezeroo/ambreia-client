<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_housing_catalog_xml" width="560" height="440" version="0.1">
  <window>
    <frame x="0" y="0" width="560" height="440" params="32769" style="103" name="vortex_housing_catalog" caption="${vortex.housing.catalog}">
      <filters>
        <DropShadowFilter distance="4" alpha="0.349" blurX="4" blurY="4"/>
      </filters>
      <children>
        <border x="8" y="4" width="160" height="392" params="16" style="102" name="categories">
          <children>
            <itemlist_vertical x="5" y="5" width="150" height="382" params="16" style="3" name="category_list">
              <children/>
              <variables>
                <var key="spacing" value="3" type="int"/>
              </variables>
            </itemlist_vertical>
          </children>
        </border>
        <dropmenu x="176" y="4" width="150" height="24" params="17" style="3" name="category_menu" caption="${vortex.housing.all_categories}"/>
        <border x="334" y="2" width="218" height="28" params="16" style="102" name="search_box">
          <children>
            <static_bitmap x="8" y="6" width="16" height="16" params="16" style="3" tags="%23icon" color="0x6a6a72">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/software_magnifier_zoom_looking_magnifying_glass_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
                <var key="pivot_point" value="center" type="String"/>
              </variables>
            </static_bitmap>
            <input x="30" y="6" width="180" height="16" params="1" style="0" name="search_input" caption="${vortex.housing.search}"/>
          </children>
        </border>
        <border x="176" y="36" width="376" height="324" params="16" style="102" name="items">
          <children>
            <scrollable_itemgrid_vertical x="10" y="10" width="360" height="308" params="16" style="3" name="item_grid">
              <children/>
              <variables>
                <var key="spacing" value="6" type="int"/>
              </variables>
            </scrollable_itemgrid_vertical>
          </children>
        </border>
        <border x="302" y="368" width="28" height="26" params="17" style="104" name="previous_page" dynamic_style="button">
          <children>
            <static_bitmap x="6" y="5" width="16" height="16" params="16" style="3" name="previous_page_icon" tags="%23icon" color="0x5a4a7a">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/arrows_pointer_left_west_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
                <var key="pivot_point" value="center" type="String"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
        <text x="334" y="373" width="60" height="16" params="16" style="3" name="page_txt" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="10" type="uint"/>
            <var key="text_color" value="0xffffff" type="hex"/>
            <var key="auto_size" value="center" type="String"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <border x="400" y="368" width="28" height="26" params="17" style="104" name="next_page" dynamic_style="button">
          <children>
            <static_bitmap x="6" y="5" width="16" height="16" params="16" style="3" name="next_page_icon" tags="%23icon" color="0x5a4a7a">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/arrows_pointer_right_east_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
                <var key="pivot_point" value="center" type="String"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
      </children>
      <variables>
        <var key="margin_left" value="3" type="int"/>
        <var key="margin_top" value="36" type="int"/>
        <var key="margin_right" value="3" type="int"/>
        <var key="margin_bottom" value="3" type="int"/>
      </variables>
    </frame>
  </window>
</layout>
