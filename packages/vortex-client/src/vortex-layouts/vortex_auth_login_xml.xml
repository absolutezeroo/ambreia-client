<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_auth_login_xml" width="300" height="300" version="0.1">
  <window>
    <frame x="0" y="0" width="300" height="300" params="32769" style="3" name="login_dialog" caption="${vortex.auth.login.title}" color="0x418db0">
      <filters>
        <DropShadowFilter distance="4" alpha="0.349" blurX="4" blurY="4"/>
      </filters>
      <children>
        <container x="0" y="4" width="294" height="257" params="16" style="3" name="content">
          <children>
            <text x="12" y="8" width="260" height="16" params="16" style="3" name="identifier_label" caption="${vortex.auth.identifier}">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <border x="12" y="26" width="270" height="26" params="16" style="2" color="0xffffff">
              <children>
                <input x="6" y="5" width="258" height="16" params="1" style="0" name="identifier_input" caption=""/>
              </children>
            </border>
            <text x="12" y="60" width="200" height="16" params="16" style="3" name="password_label" caption="${vortex.auth.password}">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <border x="12" y="78" width="270" height="26" params="16" style="2" color="0xffffff">
              <children>
                <input x="6" y="5" width="258" height="16" params="1" style="0" name="password_input" caption="">
                  <variables>
                    <var key="password" value="true" type="Boolean"/>
                  </variables>
                </input>
              </children>
            </border>
            <link x="12" y="108" width="270" height="16" params="1" style="3" name="forgot_link" caption="${vortex.auth.forgot}" treshold="0">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="10" type="uint"/>
                <var key="text_color" value="0x1077ac" type="hex"/>
                <var key="auto_size" value="right" type="String"/>
                <var key="underline" value="true" type="Boolean"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </link>
            <checkbox x="12" y="128" width="18" height="18" params="17" style="3" name="remember_me"/>
            <text x="36" y="130" width="200" height="16" params="16" style="3" caption="${vortex.auth.remember}">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <text visible="false" x="12" y="150" width="270" height="16" params="16" style="3" name="login_error" caption="${vortex.auth.error.credentials}">
              <variables>
                <var key="text_style" value="u_bold" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="text_color" value="0xc30000" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <button_thick x="12" y="166" width="270" height="28" params="131089" style="6" color="0x0aa00" name="login_button" caption="${vortex.auth.login}" width_min="270" width_max="270"/>
            <text x="12" y="206" width="270" height="16" params="16" style="3" name="no_account_txt" caption="${vortex.auth.no_account}">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="text_color" value="0x666666" type="hex"/>
                <var key="auto_size" value="center" type="String"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <button_thick x="12" y="224" width="270" height="28" params="131089" style="3" name="register_button" caption="${vortex.auth.register}" width_min="270" width_max="270"/>
          </children>
        </container>
      </children>
      <variables>
        <var key="margin_left" value="3" type="int"/>
        <var key="margin_top" value="36" type="int"/>
        <var key="margin_right" value="3" type="int"/>
        <var key="margin_bottom" value="3" type="int"/>
      </variables>
    </frame>
  </window>
</layout>
