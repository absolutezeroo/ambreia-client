<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_calendar_tab_wallet_xml" width="700" height="420" version="0.1">
  <window>
    <container x="0" y="0" width="700" height="420" params="16" style="3" name="tab_root">
      <children>
        <text x="8" y="2" width="400" height="16" params="16" style="3" caption="${vortex.calendar.wallet_title}">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="text_color" value="0xffffff" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <border x="8" y="22" width="684" height="390" params="16" style="103" name="wallet">
          <children>
            <itemlist_vertical x="0" y="6" width="684" height="378" params="16" style="3" name="currency_list">
              <children/>
              <variables>
                <var key="spacing" value="4" type="int"/>
              </variables>
            </itemlist_vertical>
          </children>
        </border>
      </children>
    </container>
  </window>
</layout>
