<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_quest_detail_header_xml" width="394" height="112" version="0.1">
  <window>
    <container x="0" y="0" width="394" height="112" params="16" style="3" name="quest_detail_header">
      <children>
        <!-- The quest's banner on the owner's parchment (images/rpg/parchement.png, 212x49, stretched to the banner). -->
        <container x="0" y="0" width="394" height="56" params="16" style="3" name="banner">
          <children>
            <static_bitmap x="0" y="0" width="394" height="56" params="16" style="3" name="banner_bg">
              <variables>
                <var key="asset_uri" value="rpg/parchement" type="String"/>
                <var key="stretched_x" value="true" type="Boolean"/>
                <var key="stretched_y" value="true" type="Boolean"/>
              </variables>
            </static_bitmap>
            <border x="6" y="6" width="44" height="44" params="16" style="104">
              <children>
                <static_bitmap x="12" y="12" width="20" height="20" params="16" style="3" name="quest_icon" tags="%23icon">
                  <variables>
                    <var key="asset_uri" value="variablefx_icon_star_power" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="pivot_point" value="center" type="String"/>
                  </variables>
                </static_bitmap>
              </children>
            </border>
            <text x="58" y="8" width="220" height="18" params="16" style="3" name="quest_title" caption="">
              <variables>
                <var key="text_style" value="u_bold" type="String"/>
                <var key="font_size" value="14" type="uint"/>
                <var key="text_color" value="0x4a2c10" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <text x="58" y="29" width="220" height="16" params="16" style="3" name="quest_subtitle" caption="">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="text_color" value="0x7a5a30" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
            <border x="242" y="17" width="92" height="22" params="16" style="104" name="repeatable_pill" visible="false">
              <children>
                <static_bitmap x="6" y="3" width="16" height="16" params="16" style="3" tags="%23icon" color="0x60a0e0">
                  <variables>
                    <var key="asset_uri" value="rpg/ui-icons/arrows_reload_refresh_rotate_clockwise_icon" type="String"/>
                    <var key="stretched_x" value="false" type="Boolean"/>
                    <var key="stretched_y" value="false" type="Boolean"/>
                    <var key="pivot_point" value="center" type="String"/>
                  </variables>
                </static_bitmap>
                <text x="26" y="3" width="62" height="16" params="16" style="3" name="repeatable_txt" caption="${vortex.quest.repeatable}">
                  <variables>
                    <var key="text_style" value="u_bold" type="String"/>
                    <var key="font_size" value="11" type="uint"/>
                    <var key="text_color" value="0x4a2c10" type="hex"/>
                    <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
                  </variables>
                </text>
              </children>
            </border>
            <border x="342" y="4" width="48" height="48" params="16" style="104" name="giver">
              <children>
                <widget x="6" y="5" width="36" height="38" params="16" style="3" name="giver_image">
                  <variables>
                    <var key="widget_type" value="avatar_image" type="String"/>
                    <var key="avatar_image:only_head" value="true" type="Boolean"/>
                    <var key="avatar_image:cropped" value="true" type="Boolean"/>
                  </variables>
                </widget>
              </children>
            </border>
          </children>
        </container>
        <text x="2" y="62" width="390" height="46" params="16" style="3" name="quest_desc" caption="">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="multiline" value="true" type="Boolean"/>
            <var key="word_wrap" value="true" type="Boolean"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>            <var key="text_color" value="0x1f2a33" type="hex"/>

          </variables>
        </text>
      </children>
    </container>
  </window>
</layout>
