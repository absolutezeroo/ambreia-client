<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_social_friend_row_xml" width="330" height="46" version="0.1">
  <window>
    <border x="0" y="0" width="330" height="46" params="17" style="2" name="friend_row" dynamic_style="lifted_hover" color="0xf2f2ec">
      <children>
        <border x="3" y="3" width="40" height="40" params="16" style="2" color="0xe4e4dc">
          <children>
            <widget x="3" y="2" width="34" height="36" params="16" style="3" name="head_image">
              <variables>
                <var key="widget_type" value="avatar_image" type="String"/>
                <var key="avatar_image:only_head" value="true" type="Boolean"/>
                <var key="avatar_image:cropped" value="true" type="Boolean"/>
              </variables>
            </widget>
          </children>
        </border>
        <text x="50" y="5" width="210" height="16" params="16" style="3" name="friend_name" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <container x="50" y="24" width="210" height="16" params="16" style="3" name="presence">
          <children>
            <shape x="0" y="4" width="9" height="9" params="16" style="3" name="status_dot" color="0x4cc040">
              <variables>
                <var key="shape" value="round_rectangle" type="String"/>
                <var key="radius" value="4" type="Number"/>
                <var key="stroke_color" value="0xff444444" type="hex"/>
                <var key="stroke_thickness" value="1" type="Number"/>
              </variables>
            </shape>
            <text x="13" y="0" width="197" height="16" params="16" style="3" name="presence_txt" caption="${vortex.social.presence.online}">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="10" type="uint"/>
                <var key="text_color" value="0x2b9a00" type="hex"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>
        <border x="268" y="11" width="24" height="24" params="17" style="2" name="chat_button" dynamic_style="button" color="0xe4e4dc">
          <children>
            <static_bitmap x="4" y="4" width="16" height="16" params="16" style="3" tags="%23icon" color="0x6aa0e0">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/software_speech_bubble_three_dots_dialogue_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
        <border x="298" y="12" width="24" height="22" params="17" style="2" name="more_button" dynamic_style="button" color="0xe4e4dc">
          <children>
            <text x="0" y="3" width="24" height="16" params="16" style="3" caption="">
              <variables>
                <var key="text_style" value="u_bold" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="auto_size" value="center" type="String"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </border>
      </children>
    </border>
  </window>
</layout>
