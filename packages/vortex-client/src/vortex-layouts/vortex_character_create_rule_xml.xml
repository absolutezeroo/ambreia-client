<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_character_create_rule_xml" width="230" height="18" version="0.1">
  <window>
    <container x="0" y="0" width="230" height="18" params="16" style="3" name="rule_line">
      <children>
        <static_bitmap x="0" y="1" width="16" height="16" params="16" style="3" name="rule_icon" tags="%23icon" color="0x40b030">
          <variables>
            <var key="asset_uri" value="rpg/ui-icons/software_signs_checkmark_checkbox_ticked_todo_icon" type="String"/>
            <var key="stretched_x" value="false" type="Boolean"/>
            <var key="stretched_y" value="false" type="Boolean"/>
          </variables>
        </static_bitmap>
        <text x="20" y="1" width="210" height="16" params="16" style="3" name="rule_txt" caption="${vortex.charcreate.name.rule.length}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="10" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
      </children>
    </container>
  </window>
</layout>
