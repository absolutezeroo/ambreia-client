<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_social_sent_row_xml" width="330" height="44" version="0.1">
  <window>
    <border x="0" y="0" width="330" height="44" params="17" style="104" name="sent_row" dynamic_style="lifted_hover">
      <children>
        <border x="3" y="3" width="38" height="38" params="16" style="104">
          <children>
            <widget x="2" y="1" width="34" height="36" params="16" style="3" name="head_image">
              <variables>
                <var key="widget_type" value="avatar_image" type="String"/>
                <var key="avatar_image:only_head" value="true" type="Boolean"/>
                <var key="avatar_image:cropped" value="true" type="Boolean"/>
              </variables>
            </widget>
          </children>
        </border>
        <text x="50" y="5" width="100" height="16" params="16" style="3" name="player_name" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="50" y="22" width="100" height="16" params="16" style="3" name="player_level" caption="">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="10" type="uint"/>
            <var key="text_color" value="0x666666" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <border x="180" y="12" width="112" height="20" params="16" style="104" name="sent_pill">
          <children>
            <text x="0" y="2" width="112" height="16" params="16" style="3" name="sent_pill_txt" caption="${vortex.friends.request_sent}">
              <variables>
                <var key="text_style" value="u_bold" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="text_color" value="0x666666" type="hex"/>
                <var key="auto_size" value="center" type="String"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </border>
        <border x="298" y="10" width="24" height="22" params="17" style="104" name="more_button" dynamic_style="button">
          <children>
            <static_bitmap x="4" y="3" width="16" height="16" params="16" style="3" name="more_icon" tags="%23icon" color="0x5a4a7a">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/controller_buttons_menu_options_settings_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
                <var key="pivot_point" value="center" type="String"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
      </children>
    </border>
  </window>
</layout>
