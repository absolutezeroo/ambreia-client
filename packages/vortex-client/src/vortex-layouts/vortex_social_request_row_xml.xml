<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_social_request_row_xml" width="330" height="50" version="0.1">
  <window>
    <border x="0" y="0" width="330" height="50" params="17" style="104" name="request_row" dynamic_style="lifted_hover">
      <children>
        <border visible="false" x="0" y="0" width="330" height="50" params="16" style="104" name="selected" color="0xffd890"/>
        <border x="4" y="5" width="40" height="40" params="16" style="104">
          <children>
            <widget x="3" y="2" width="34" height="36" params="16" style="3" name="head_image">
              <variables>
                <var key="widget_type" value="avatar_image" type="String"/>
                <var key="avatar_image:only_head" value="true" type="Boolean"/>
                <var key="avatar_image:cropped" value="true" type="Boolean"/>
              </variables>
            </widget>
          </children>
        </border>
        <text x="52" y="3" width="210" height="16" params="16" style="3" name="player_name" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="52" y="18" width="210" height="16" params="16" style="3" name="player_level" caption="">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="10" type="uint"/>
            <var key="text_color" value="0x666666" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="52" y="32" width="210" height="16" params="16" style="3" name="request_context" caption="${vortex.friends.context.common_group}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="10" type="uint"/>
            <var key="text_color" value="0xb07a10" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <border x="268" y="13" width="24" height="24" params="17" style="104" name="accept_button" dynamic_style="button" color="0x4caa30">
          <children>
            <static_bitmap x="4" y="4" width="16" height="16" params="16" style="3" tags="%23icon" color="0xffffff">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/software_signs_checkmark_checkbox_ticked_todo_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
        <border x="298" y="13" width="24" height="24" params="17" style="104" name="decline_button" dynamic_style="button" color="0xd84040">
          <children>
            <static_bitmap x="5" y="5" width="16" height="16" params="16" style="3" tags="%23icon" color="0xffffff">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/software_signs_maths_multiplication_x_crossout_checkmark_cancel_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
      </children>
    </border>
  </window>
</layout>
