<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_map_editor_layer_row_xml" width="200" height="24" version="0.1">
  <window>
    <border x="0" y="0" width="200" height="24" params="17" style="2" name="layer_row" dynamic_style="lifted_hover" color="0xf2f2ec">
      <children>
        <border x="2" y="1" width="22" height="22" params="17" style="2" name="visibility_button" dynamic_style="button" color="0xffffff">
          <children>
            <static_bitmap x="3" y="3" width="16" height="16" params="16" style="3" tags="%23icon" color="0x6a9fd8">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/media_eyeball_vision_shown_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
        <border x="30" y="6" width="12" height="12" params="16" style="2" name="layer_swatch" color="0x8a6a4a">
          <children/>
        </border>
        <text x="48" y="4" width="120" height="16" params="16" style="3" name="layer_label" caption="${vortex.mapeditor.layer.floor}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <border x="174" y="1" width="22" height="22" params="17" style="2" name="lock_button" dynamic_style="button" color="0xffffff">
          <children>
            <static_bitmap x="3" y="3" width="16" height="16" params="16" style="3" tags="%23icon" color="0xb0b0a8">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/tools_crafting_padlock_unlocked_1_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
      </children>
    </border>
  </window>
</layout>
