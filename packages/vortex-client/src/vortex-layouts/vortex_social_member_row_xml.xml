<?xml version="1.0" encoding="UTF-8"?>
<layout name="vortex_social_member_row_xml" width="560" height="40" version="0.1">
  <window>
    <border x="0" y="0" width="560" height="40" params="17" style="104" name="member_row" dynamic_style="lifted_hover">
      <children>
        <border visible="false" x="0" y="0" width="560" height="40" params="16" style="104" name="selected" color="0xffd890"/>
        <border x="2" y="4" width="32" height="32" params="16" style="104">
          <children>
            <widget x="5" y="5" width="20" height="20" params="16" style="3" name="head_image">
              <variables>
                <var key="widget_type" value="avatar_image" type="String"/>
                <var key="avatar_image:only_head" value="true" type="Boolean"/>
                <var key="avatar_image:cropped" value="true" type="Boolean"/>
                <var key="avatar_image:scale" value="sh" type="String"/>
              </variables>
            </widget>
          </children>
        </border>
        <text x="38" y="12" width="80" height="16" params="16" style="3" name="member_name" caption="">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <static_bitmap x="121" y="12" width="16" height="16" params="16" style="3" tags="%23icon" color="0x6a9fd8">
          <variables>
            <var key="asset_uri" value="rpg/ui-icons/rpg_item_stat_shield_defense_armor_icon" type="String"/>
            <var key="stretched_x" value="false" type="Boolean"/>
            <var key="stretched_y" value="false" type="Boolean"/>
          </variables>
        </static_bitmap>
        <text x="140" y="12" width="70" height="16" params="16" style="3" name="member_role" caption="${vortex.guild.role.officer}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="text_color" value="0x1077ac" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="212" y="12" width="30" height="16" params="16" style="3" name="member_level" caption="">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="auto_size" value="center" type="String"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <shape x="250" y="16" width="9" height="9" params="16" style="3" name="status_dot" color="0x4cc040">
          <variables>
            <var key="shape" value="round_rectangle" type="String"/>
            <var key="radius" value="4" type="Number"/>
            <var key="stroke_color" value="0xff444444" type="hex"/>
            <var key="stroke_thickness" value="1" type="Number"/>
          </variables>
        </shape>
        <text x="262" y="12" width="70" height="16" params="16" style="3" name="member_status" caption="${vortex.social.presence.online}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="text_color" value="0x2b9a00" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="336" y="12" width="90" height="16" params="16" style="3" name="member_last" caption="${vortex.social.now}">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <container x="430" y="12" width="90" height="16" params="16" style="3" name="member_contribution">
          <children>
            <static_bitmap x="0" y="0" width="16" height="16" params="16" style="3" tags="%23icon" color="0xf0c030">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/rpg_coin_gold_currency_money_gp_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
            <text x="18" y="0" width="72" height="16" params="16" style="3" name="member_contribution_txt" caption="">
              <variables>
                <var key="text_style" value="u_regular" type="String"/>
                <var key="font_size" value="11" type="uint"/>
                <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
              </variables>
            </text>
          </children>
        </container>
        <border x="530" y="8" width="24" height="22" params="17" style="104" name="more_button" dynamic_style="button">
          <children>
            <static_bitmap x="4" y="3" width="16" height="16" params="16" style="3" name="more_icon" tags="%23icon" color="0x5a4a7a">
              <variables>
                <var key="asset_uri" value="rpg/ui-icons/controller_buttons_menu_options_settings_icon" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
                <var key="pivot_point" value="center" type="String"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
      </children>
    </border>
  </window>
</layout>
