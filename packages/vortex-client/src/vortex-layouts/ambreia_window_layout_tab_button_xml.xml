<?xml version="1.0"?>
<!-- The Ambreia dark theme's tab button: habbo_window_layout_tab_button_3 with a white caption. -->
<layout name="ambreia_window_layout_tab_button" width="20" height="32" version="0.1">
	<window>
		<container x="0" y="0" width="20" height="32" background="false" tags="_EXCLUDE, _INTERNAL">
			<params>
				<param name="use_parent_graphic_context" />
			</params>
		</container>
		<label name="title" style="0" x="0" y="4" width="20" height="30" background="false" tags="title, TAB_BUTTON_TITLE, _EXCLUDE, _INTERNAL">
			<params>
				<param name="relative_horizontal_scale_center" />
				<param name="relative_vertical_scale_center" />
				<param name="use_parent_graphic_context" />
				<param name="inherit_caption" />
			</params>
			<variables>
				<var key="text_style" value="button_shiny_regular" />
				<var key="text_color" value="0xffe8eef5" type="hex" />
				<var key="selected_text_color" value="0xff1f2a33" type="hex" />
				<var key="margins"><value>
					<Map>
						<var key="left"   value="10" type="int" />
						<var key="top"    value="6" type="int" />
						<var key="right"  value="10" type="int" />
						<var key="bottom" value="4" type="int" />
					</Map>
				</value></var>
			</variables>
		</label>
	</window>
</layout>
