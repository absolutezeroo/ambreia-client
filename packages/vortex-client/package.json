{
  "name": "vortex-client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node ./tools/build-vfx-sheets.mjs && node ./tools/bundle-assets.mjs",
    "predev": "node ./tools/build-vfx-sheets.mjs && node ./tools/bundle-assets.mjs",
    "dev": "vite",
    "build": "tsc && vite build && node ./tools/check-release-bundle.mjs",
    "preview": "vite preview",
    "build:window-data": "node ./tools/build-window-assets.mjs",
    "build:bundle": "node ./tools/bundle-assets.mjs",
    "build:ambreia": "tsx ./tools/build-ambreia.ts",
    "build:ambreia:all": "node ./tools/build-ambreia-all.mjs",
    "build:vfx": "node ./tools/build-vfx-sheets.mjs",
    "build:monsters": "node ./tools/build-monsters.mjs",
    "build:monster-art": "node ./tools/monster-art/build.mjs",
    "monster-art:preview": "node ./tools/monster-art/preview.mjs",
    "gather:ambreia": "node ./tools/gather-ambreia-sources.mjs",
    "import:avatar-configurations": "node ./tools/import-avatar-configurations.mjs --write",
    "import:crypted-images": "node ./tools/import-crypted-images.mjs --write",
    "import:crypted-sounds": "node ./tools/import-crypted-sounds.mjs --write",
    "import:localizations": "node ./tools/import-localizations.mjs --write",
    "tools": "node ./tools/dashboard/server.ts"
  },
  "dependencies": {
    "@ambreia/common": "workspace:*",
    "@ambreia/game": "workspace:*",
    "@ambreia/iso": "workspace:*",
    "@ambreia/kernel": "workspace:*",
    "@ambreia/net": "workspace:*",
    "@ambreia/protocol": "workspace:*",
    "@ambreia/ui": "workspace:*",
    "eventemitter3": "^5.0.1",
    "pixi.js": "^8.6.6",
    "vortex-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@xmldom/xmldom": "^0.9.7",
    "esbuild": "^0.25.12",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.34.5",
    "truffle-text": "^2.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
