{
  "name": "vortex",
  "version": "0.1.0",
  "private": true,
  "description": "Modern Habbo client renderer - Lighter than Nitro",
  "scripts": {
    "setup": "node install.mjs",
    "pack:assets": "node install.mjs --pack",
    "dev": "pnpm --filter vortex-client dev",
    "build": "pnpm --filter vortex-client build",
    "preview": "pnpm --filter vortex-client preview",
    "imager:dev": "pnpm --filter vortex-imager dev",
    "imager:build": "pnpm --filter vortex-imager build",
    "imager": "pnpm --filter vortex-imager start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "author": "Clayton",
  "license": "GPL-3.0",
  "dependencies": {
    "vite": "^6.4.3"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript-eslint": "^8.62.1",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
