# syntax=docker/dockerfile:1

# =================================================================================================
# vortex-web — the hotel's website
# =================================================================================================
# The habbo-web port, served at the apex. Its own resource, separate from the client: the two are
# different packages on different release rhythms, and a copy fix on the front page has no business
# waiting on `tsc && vite build` over the whole game client.
#
# In Coolify: Build Pack "Dockerfile", Dockerfile Location /Dockerfile.web, Base Directory /.

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /src

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/vortex-client/package.json packages/vortex-client/
COPY packages/vortex-engine/package.json packages/vortex-engine/
COPY packages/vortex-glaze/package.json packages/vortex-glaze/
COPY packages/vortex-imager/package.json packages/vortex-imager/
COPY packages/vortex-web/package.json packages/vortex-web/
RUN pnpm install --frozen-lockfile

COPY . .

# The two absolute hosts the site cannot derive from its own origin, and the reason it already has
# the seam for them: packages/vortex-web/src/lib/config.js reads both, falling back to the relative
# paths its dev server proxies. So nothing about the source changes to deploy this — only what is
# handed to the build.
#
# VITE_CLIENT_URL is the game client, on its own host. /hotel iframes it with the SSO ticket on the
# query string, which is what makes a cross-origin client work at all: the ticket travels in the
# URL, so the client needs none of this site's session cookie.
#
# VITE_ASSET_BASE points c_images at the asset host. Left empty the site would ask THIS origin for
# promo art and badges, and nothing here serves them.
ARG VITE_CLIENT_URL=https://client.vortex-hotel.online
ARG VITE_ASSET_BASE=https://assets.vortex-hotel.online

RUN pnpm --filter vortex-web build

# =================================================================================================
# Runtime
# =================================================================================================
FROM caddy:2-alpine AS runtime

COPY Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /src/packages/vortex-web/dist /srv

EXPOSE 80

# Same probe and same reasoning as the client's Dockerfile: `/` proves Caddy is up and /srv holds a
# build, the two upstreams (/api, /habbo-imaging) stay out of it so an emulator outage does not
# restart the website, and wget is the busybox applet the alpine base already carries.
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
