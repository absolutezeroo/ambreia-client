              <variables>
                <var key="asset_uri" value="rpg/dungeon-objects/icon_37" type="String"/>
                <var key="stretched_x" value="false" type="Boolean"/>
                <var key="stretched_y" value="false" type="Boolean"/>
              </variables>
            </static_bitmap>
          </children>
        </border>
        <text x="50" y="8" width="74" height="16" params="16" style="3" name="reward_name" caption="${vortex.ui.gold}">
          <variables>
            <var key="text_style" value="u_bold" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
        <text x="50" y="25" width="74" height="16" params="16" style="3" name="reward_value" caption="">
          <variables>
            <var key="text_style" value="u_regular" type="String"/>
            <var key="font_size" value="11" type="uint"/>
            <var key="text_color" value="0x666666" type="hex"/>
            <var key="mouse_wheel_enabled" value="false" type="Boolean"/>
          </variables>
        </text>
      </children>
    </border>
  </window>
</layout>
