# =================================================================================================
# One origin for the whole hotel.
# =================================================================================================
# The client resolves everything against the origin it was served from — install.mjs leaves
# `url.prefix` and `pocket.api` EMPTY on purpose and App.ts::fillOriginPrefixes() fills them at
# boot, and packages/vortex-client/index.html dials `wss://<origin>/ws` for anything that is not
# localhost. So the client needs no build-time knowledge of where the hotel lives: it only needs
# every service to answer on its own origin, which is this file's whole job.
#
# The upside is not tidiness. One origin means no CORS policy to keep in sync, no cross-site
# cookie to age out, one certificate, and an emulator that needs no public domain at all — it is
# reached over the Docker network by the internal hostname Coolify assigns it.

{
	# Coolify's proxy terminates TLS in front of this container, so Caddy serves plain HTTP on :80
	# and must not try to obtain a certificate of its own — it has no public address to validate
	# against and would retry ACME forever.
	auto_https off
}

:80 {
	encode zstd gzip

	# --- headers every response carries --------------------------------------------------------
	# The SSO ticket rides on `?sso=` in the page URL: `same-origin` keeps it out of the Referer of
	# anything cross-origin the page may load. `nosniff` stops a script served as HTML (the SPA
	# fallback) from being executed as one. `frame-ancestors 'self'` says out loud what the design
	# assumes: the site frames this client from the same origin (SiteChannel.ts), nobody else does.
	# The full policy is Report-Only on purpose: the client decodes WebAssembly (truffle-text), draws
	# from blob: and data: URLs and dials wss://, and a wrong directive would blank the game; enforce
	# it only once the browser console shows no violation through login and a room.
	header {
		Referrer-Policy same-origin
		X-Content-Type-Options nosniff
		Content-Security-Policy "frame-ancestors 'self'"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' wss: ws:; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'"
		-Server
	}

	# The asset tree is its own resource (Dockerfile.assets) on its own hostname, but the client
	# still asks THIS host for it — see the asset section below. Reaching it only through the
	# absolute URLs in gamedata/hashes.json was the original plan and it does not hold: hashes.json
	# is absolute, external_variables is not.
	#
	# EMULATOR_UPSTREAM, IMAGER_UPSTREAM and ASSETS_UPSTREAM are the other containers' network
	# aliases. Named *_UPSTREAM and not *_HOST deliberately: IMAGER_HOST is already the imager's OWN
	# bind address
	# (its config.ts defaults it to 0.0.0.0), so the same name on two apps in the same panel would
	# mean opposite things — and set on the wrong one, the imager would try to bind to a hostname
	# that is not an interface.

	# --- the web API ---------------------------------------------------------------------------
	# `handle_path` strips the matched prefix, which is exactly the rewrite the dev server does
	# (packages/vortex-client/vite.config.ts). The client's shipped configuration says
	# `web.api.en=/webapi`, an origin-root path, and asks for `<web.api>/api/public/...`; the
	# emulator serves `/api/public/...`. Without the strip every call arrives one segment deep and
	# answers 404 — with a 200-shaped index.html if it fell through to the SPA, which is the
	# failure that costs the most time to read.
	handle_path /webapi/* {
		reverse_proxy {$EMULATOR_UPSTREAM}:8080
	}

	# Some calls are made against the origin root rather than through `web.api`. `handle`, not
	# `handle_path`: these keep their prefix.
	handle /api/* {
		reverse_proxy {$EMULATOR_UPSTREAM}:8080
	}

	# --- the game socket -----------------------------------------------------------------------
	# reverse_proxy upgrades WebSocket connections on its own; no extra directive is needed. The
	# emulator must be listening on 0.0.0.0 for this to reach it — its default is 127.0.0.1, which
	# inside a container is the container's own loopback and nothing else.
	handle /ws {
		reverse_proxy {$EMULATOR_UPSTREAM}:30001
	}

	# --- avatars, badges, furni thumbnails -------------------------------------------------------
	handle /habbo-imaging/* {
		reverse_proxy {$IMAGER_UPSTREAM}:8081
	}

	# --- the asset tree --------------------------------------------------------------------------
	# Five paths, one upstream, and none of them optional.
	#
	# `external_variables` — the runtime configuration the client fetches through hashes.json — is
	# written in terms of `${url.prefix}`, which App.ts::fillOriginPrefixes() fills with the origin
	# the client was served from. So `furnidata.load.url`, `flash.client.url`, `dynamic.download.url`
	# and `image.library.badgepart.url` all resolve to THIS host, whatever hostname the asset tree
	# answers on. hashes.json itself is absolute and misled the first reading of this: the manifest
	# loads from anywhere, everything the manifest points at does not.
	#
	# These are exactly the paths vite.config.ts proxies in development, plus /gamecenter. Without
	# them each one falls into the SPA fallback at the bottom of this file and answers index.html
	# with a 200 — which is why the client crashed on `Failed loading gamedata hashes`: JSON.parse
	# on a 379-byte HTML document, reported as a parse error rather than a routing one.
	handle /gamedata/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	handle /c_images/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	handle /dcr/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	handle /gordon/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	handle /gamecenter/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	# The `.ambreia` families (clothing, effects, room, pets, furniture, icons): the asset-packs
	# feature defaults every family to `${url.prefix}/ambreia/<family>/`, i.e. THIS origin, and
	# vite.config.ts proxies the same path in development. Without this route the request fell into
	# the SPA fallback and `ambreia.json` came back as index.html: "not an .ambreia directory".
	handle /ambreia/* {
		reverse_proxy {$ASSETS_UPSTREAM}:80
	}

	# --- the client itself -------------------------------------------------------------------------
	# Build output first, and deliberately outside the fallback below. Every name under /assets is
	# content-hashed, so a request for one that is missing is a bug and must answer 404. Inside the
	# fallback it would answer `index.html` with a 200 — a script or an image served HTML, which
	# fails later and elsewhere. The site next door shipped with no sprite sheet exactly that way.
	handle /assets/* {
		root * /srv
		# Content-hashed names: a byte never changes under the same URL, so the browser may keep it
		# forever and skip the revalidation round-trip on every load of the 4 MB bundle.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Last, so it only catches what nothing above claimed. `try_files` gives the SPA its fallback:
	# a deep link must answer with index.html rather than 404.
	handle {
		root * /srv
		# index.html, config.json and the two assets-*.ambreia bundles are not hashed: `no-cache`
		# makes every load revalidate them (ETag), so a deploy never pairs a new index.html with a
		# stale bundle whose layout keys the new code expects — the silent "blank window" skew.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
