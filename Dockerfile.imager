# syntax=docker/dockerfile:1

# =================================================================================================
# vortex-imager
# =================================================================================================
# This file lives at the repository root rather than next to the package it builds, and that is not
# tidiness — it is the only way the build context is right.
#
# The imager depends on vortex-engine through the `workspace:` protocol, so it cannot be installed
# on its own: the install needs the lockfile, the workspace manifest and every package.json in the
# tree. Under packages/vortex-imager/ the builder took THAT directory as the context, and every
# COPY from the root failed with "/pnpm-workspace.yaml: not found" while the root .dockerignore was
# never read either. A Dockerfile at the root cannot be given the wrong context by any setting.
#
# In Coolify: "Dockerfile Location" = /Dockerfile.imager, "Base Directory" = /.

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /src

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/vortex-client/package.json packages/vortex-client/
COPY packages/vortex-engine/package.json packages/vortex-engine/
COPY packages/vortex-glaze/package.json packages/vortex-glaze/
COPY packages/vortex-imager/package.json packages/vortex-imager/
COPY packages/vortex-web/package.json packages/vortex-web/
RUN pnpm install --frozen-lockfile

COPY . .

# Not optional, and not a copy-paste from the front's Dockerfile. The imager reads the client's own
# avatar configuration — HabboAvatarAnimation.xml and its three siblings — out of
# packages/vortex-client/src/assets/configurations (see config.ts, `avatarConfigDir`). That
# directory is gitignored: install.mjs produces it by unpacking vortex-client-assets.zip. Without
# this line the imager starts, logs four "Missing embedded avatar asset" warnings, and renders
# nothing that has a body.
RUN node install.mjs --skip-install --skip-checks

RUN pnpm --filter vortex-imager build

# =================================================================================================
# Runtime
# =================================================================================================
# The whole workspace is carried over rather than dist/ alone. esbuild bundles the TypeScript, but
# `@napi-rs/canvas` is a native module — it cannot be bundled, and pnpm's node_modules is a tree of
# symlinks into .pnpm/, so copying the directory alone would carry broken links. Copying /src keeps
# both halves consistent. The image is larger than it strictly needs to be; that is the trade, and
# a `pnpm deploy --prod` refinement is the upgrade path if it ever matters.
FROM node:22-slim AS runtime
WORKDIR /src

COPY --from=build /src /src

# IMAGER_ASSETS_ROOT is deliberately NOT set, and that is the whole point of this comment.
#
# Setting it does not mean "where the assets are". src/shim/globals.ts replaces `globalThis.fetch`
# with one that serves every URL under IMAGER_ASSETS_BASE_URL from that directory instead of over
# the network — and answers `404 Not Found` itself when the file is not there. So a stale value
# here does not fall back to HTTP: it silently shadows the asset host and manufactures a 404 that
# is indistinguishable from the server's own. This image carried `IMAGER_ASSETS_ROOT=/assets` from
# an earlier design where the tree was a shared mount; the tree now lives in its own resource, and
# the leftover ENV made the imager crashloop against a host that was answering 200 the whole time.
#
# Unset, the imager fetches from IMAGER_ASSETS_BASE_URL like the client does — which is also what
# stops the two rendering against different copies.
ENV IMAGER_PORT=8081 \
    IMAGER_CACHE_DIR=/cache

# The render cache. The only thing this container keeps.
VOLUME /cache

EXPOSE 8081

# The server already has the route — src/server.ts serves `/health` with the cache sizes, the room
# pipeline's state and a database ping. The probe only asks for a 2xx: a database reported "down"
# in that body is an upstream's problem, and restarting the imager does not fix it.
#
# `node -e` rather than curl, and no apt layer to get one: node:22-slim ships neither curl nor
# wget, and node 22 has a global fetch. The port is read back out of the environment so overriding
# IMAGER_PORT does not leave the probe knocking on 8081.
#
# start-period is generous because the imager resolves its avatar configuration and warms the
# asset host over HTTP before it listens.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD ["node", "-e", "fetch(`http://127.0.0.1:${process.env.IMAGER_PORT ?? 8081}/health`).then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

CMD ["node", "packages/vortex-imager/dist/index.js"]
